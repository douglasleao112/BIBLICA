# Imagens estaticas da VSL: cache no navegador por 7 dias.
# O CDN pode manter a copia por mais tempo porque cada deploy da Netlify
# invalida automaticamente os arquivos alterados na borda.
/consultoria-eua/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
  Netlify-CDN-Cache-Control: public, max-age=31536000
  X-Content-Type-Options: nosniff

# Rastreamento e atribuicao sempre revalidam para evitar codigo antigo.
/consultoria-eua/attribution.js
  Cache-Control: public, max-age=0, must-revalidate
  Netlify-CDN-Cache-Control: public, max-age=0, stale-while-revalidate=60
